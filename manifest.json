{
  "manifest_version": 2,
  "name": "Email Assistant",
  "version": "0.0.20",
  "description": "Automatically tags messages based on AI rules, with configurable LLM providers, custom ports and models, batch tagging and AI summaries",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "accountsRead",
    "accountsFolders",
    "storage",
    "notifications",
    "messagesTags",
    "messagesTagsList",
    "mailTabs",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "page": "background.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "message_display_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "email-assistant@borisxxz.github.io",
      "strict_min_version": "102.0",
      "update_url": "https://github.com/borisxxz/thunderbird_email_assistant_ai/releases/latest/download/updates.json"
    }
  },
  "author": "borisxxz",
  "homepage_url": "https://github.com/borisxxz/thunderbird_email_assistant_ai"
}